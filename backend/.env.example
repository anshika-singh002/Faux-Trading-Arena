# ============================================================
# Faux Trading — Backend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/faux_trading

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# App mode
DEBUG=true

# Virtual trading settings
INITIAL_VIRTUAL_BALANCE=100000.0
TRADING_FEE_PERCENT=0.001
SLIPPAGE_PERCENT=0.0005

# AI mode: "mock" uses MockAIService, "live" uses MLModelAIService
AI_MODE=mock
AI_MODEL_API_URL=
AI_MODEL_API_KEY=
