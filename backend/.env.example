# ============================================================
# Faux Trading - Backend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Security - generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database. SQLite works out of the box.
DATABASE_URL=sqlite+aiosqlite:///./faux_trading.db
# PostgreSQL instead (also: pip install -r requirements-postgres.txt):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/faux_trading

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS - JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# App mode
DEBUG=true

# Virtual trading settings (INR)
INITIAL_VIRTUAL_BALANCE=10000000.0   # Rs 1 crore per user
TRADING_FEE_PERCENT=0.001
SLIPPAGE_PERCENT=0.0005

# Live market data (Yahoo Finance). Set false to run fully offline on simulated prices.
LIVE_MARKET_DATA=true
LIVE_REFRESH_SECONDS=60
DAILY_REFRESH_SECONDS=900

# AI mode: "mock" uses MockAIService, "live" uses MLModelAIService
AI_MODE=mock
AI_MODEL_API_URL=
AI_MODEL_API_KEY=

# GNews API (optional) - https://gnews.io
GNEWS_API_KEY=
